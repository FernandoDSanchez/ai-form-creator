# local RAGFlow stack (independent checkout, not part of this app)
# Anchored to the root on purpose: without the slash, this pattern also ignored
# iac/k8s/components/apps/rag/ragflow/ (the Kustomize component, which DOES go
# into the repo).
/ragflow

# iac — tenant secrets. The forjate .env files are not called ".env", so the
# patterns above do not cover them.
iac/**/secrets/*.env
!iac/**/secrets/*.env.example

# cluster credentials: never into the repo
kubeconfig
*.kubeconfig
*.pem
*.key
*.p12
*.pfx

# local tooling
.claude/settings.local.json
HUMAN-TASK.md

