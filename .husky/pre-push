# Los contratos van primero, y se recompilan: las apps tipan contra el `dist/`
# del paquete, así que si alguien tocó `packages/contracts/src` sin rebuildear,
# los `check-types` de abajo mirarían tipos viejos y darían verde en falso.
(cd packages/contracts && npm run check-types && npm run build)
(cd apps/front && npm run check-types && npm run test)
(cd apps/back && npm run check-types && npm run test)
