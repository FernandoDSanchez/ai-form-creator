# Copy to `.env` (it is in .gitignore) and fill in.

NODE_ENV=development
PORT=8080

# --- Postgres ---
# In the cluster: the `app-postgres` Service of the ai-form-creator namespace.
# Locally, with a port-forward:
#   kubectl -n ai-form-creator port-forward svc/app-postgres 5432:5432
DATABASE_URL=postgresql://app:changeme@localhost:5432/ai_form_creator

# --- RAGFlow ---
# In the cluster: http://ragflow:9380
# Locally, with the docker stack in ragflow/: http://localhost:9380
RAGFLOW_API_URL=http://localhost:9380

# API key generated from the RAGFlow UI.
RAGFLOW_API_KEY=

# Dataset (knowledge base) where regulatory documents land.
# Take it from the KB URL in the UI, or with:
#   curl -H "Authorization: Bearer $RAGFLOW_API_KEY" \
#        http://localhost:9380/api/v1/datasets
RAGFLOW_DATASET_ID=
