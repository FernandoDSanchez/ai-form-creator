# Copiar a `.env` (está en .gitignore) y completar.

NODE_ENV=development
PORT=8080

# --- Postgres ---
# En el cluster: el Service `app-postgres` del namespace ai-form-creator.
# En local, con port-forward:
#   kubectl -n ai-form-creator port-forward svc/app-postgres 5432:5432
DATABASE_URL=postgresql://app:changeme@localhost:5432/ai_form_creator

# --- RAGFlow ---
# En el cluster: http://ragflow:9380
# En local, con el stack de docker de ragflow/: http://localhost:9380
RAGFLOW_API_URL=http://localhost:9380

# API key generada desde la UI de RAGFlow.
RAGFLOW_API_KEY=

# Dataset (knowledge base) donde aterrizan los documentos regulatorios.
# Se obtiene de la URL de la KB en la UI, o con:
#   curl -H "Authorization: Bearer $RAGFLOW_API_KEY" \
#        http://localhost:9380/api/v1/datasets
RAGFLOW_DATASET_ID=
