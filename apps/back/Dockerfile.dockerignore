# Ignore propio de este Dockerfile: BuildKit lo prefiere sobre el
# `.dockerignore` de la raíz del contexto. Existe porque el contexto pasó a ser
# el monorepo entero (el back necesita `packages/contracts`), y sin esto se le
# mandarían al daemon el checkout de RAGFlow, el front y todos los node_modules.

# lo que se reinstala/recompila dentro de la imagen
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

# secretos y ruido local
**/.env
**/.env.*
**/*.log
.git
.husky
.claude

# lo que no participa del build del back
apps/front
ragflow
iac
steps
