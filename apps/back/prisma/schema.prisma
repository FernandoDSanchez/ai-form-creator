// Esquema de la base de la app (Service `app-postgres` del namespace).
//
// Prisma vive en la capa de infraestructura: el modelo de acá NO es el modelo
// de dominio. La entidad se define en `@ai-form-creator/contracts` (el mismo
// contrato que consume el front), `src/regulatory-documents/domain/regulatory-document.ts`
// la expone al núcleo y `infrastructure/persistence/regulatory-document.mapper.ts`
// traduce entre ambos. Cambiar una columna no debe obligar a tocar el dominio.
//
// Los `DateTime` de acá se vuelven string ISO 8601 en el mapper: la entidad
// cruza a JSON y no maneja `Date`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado del pipeline de ingesta. Nace en PENDING cuando el archivo ya está
/// en RAGFlow pero todavía nadie lo procesó; el workflow de Temporal (futuro)
/// será el único que lo mueva de ahí.
enum RegulatoryDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

/// Estado del pipeline de generación. Lo escribe el back al aceptar el pedido
/// (PENDING) y a partir de ahí lo mueve el worker de Temporal. Cada cambio
/// dispara un `pg_notify` (ver la migración `..._form_generation`), que es como
/// el back se entera sin hacer polling.
///
/// Los literales son los mismos de `formGenerationStatuses` en
/// `packages/contracts`. No hay chequeo automático de que coincidan: el que los
/// ata es el mapper de persistencia, donde TypeScript compara el enum de Prisma
/// contra el tipo del contrato.
enum FormGenerationStatus {
  PENDING
  RETRIEVING
  GENERATING
  VALIDATING
  REPAIRING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

model FormGeneration {
  id String @id @default(uuid()) @db.Uuid

  /// El pedido en lenguaje natural, tal cual lo escribió la persona.
  prompt String

  /// Documentos elegidos, por su id nuestro.
  ///
  /// Arreglo de UUIDs y no una tabla de unión a propósito: esto es la foto del
  /// pedido, no una relación viva. Si mañana se borra un documento, lo que se
  /// generó tiene que poder seguir explicándose con lo que había ese día — y
  /// una FK con ON DELETE CASCADE se llevaría justamente esa evidencia.
  regulatoryDocumentIds String[] @map("regulatory_document_ids") @db.Uuid

  status   FormGenerationStatus @default(PENDING)
  /// Cuántas veces se le pidió el formulario al modelo, reintentos incluidos.
  attempts Int                  @default(0)

  /// Salida del modelo ya validada contra `generatedFormSchema`.
  draft Json?

  /// El borrador compilado a JSON de Formily. Es lo que renderiza el front.
  formilySchema Json? @map("formily_schema")

  failureReason String?   @map("failure_reason")
  reviewerNote  String?   @map("reviewer_note")
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("form_generations")
}

model RegulatoryDocument {
  id String @id @default(uuid()) @db.Uuid

  /// `id` que devuelve RAGFlow al subir el archivo. Es la clave con la que se
  /// consulta el estado del parseo y los chunks. Único: un archivo subido dos
  /// veces genera dos documentos distintos en RAGFlow, así que un choque acá
  /// significaría un bug nuestro, no un duplicado legítimo del usuario.
  ragflowDocumentId String @unique @map("ragflow_document_id")

  /// Dataset (knowledge base) de RAGFlow donde quedó el archivo.
  ragflowDatasetId String @map("ragflow_dataset_id")

  fileName  String                   @map("file_name")
  mimeType  String                   @map("mime_type")
  sizeBytes Int                      @map("size_bytes")
  status    RegulatoryDocumentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("regulatory_documents")
}
