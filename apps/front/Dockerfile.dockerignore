# Ignore file of this Dockerfile: BuildKit prefers it over the `.dockerignore`
# at the root of the context. It exists because the context became the whole
# monorepo (the front needs `packages/contracts`), and without it the RAGFlow
# checkout, the back and every node_modules would be sent to the daemon.

# what gets reinstalled/rebuilt inside the image
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

# secrets and local noise
**/.env
**/.env.*
**/*.log
.git
.husky
.claude

# these do not take part in the front build
apps/back
ragflow
iac
steps
apps/front/generators
apps/front/plopfile.js
apps/front/eslint.config.js
apps/front/src/**/__tests__
