/** Endpoints de la feature. Ningún literal de URL fuera de este archivo. */
const basePath = '/{{kebabCase entity}}s';

export const {{camelCase name}}Endpoints = {
  {{camelCase entity}}s: basePath,
  {{camelCase entity}}: (id: string) => basePath + '/' + id,
} as const;

/** Claves de react-query de la feature. */
export const {{camelCase name}}QueryKeys = {
  all: ['{{kebabCase entity}}s'] as const,
  lists: () => [...{{camelCase name}}QueryKeys.all, 'list'] as const,
  detail: (id: string) =>
    [...{{camelCase name}}QueryKeys.all, 'detail', id] as const,
} as const;
