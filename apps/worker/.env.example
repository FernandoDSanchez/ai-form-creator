NODE_ENV=development

# The app's Postgres. The worker writes the status of every generation into the
# same database as the back; migrations are run by the back, not by this one.
DATABASE_URL=postgresql://app:changeme@localhost:5432/ai_form_creator

# Temporal frontend. In the cluster: temporal-server:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Model proxy. In the cluster: http://litellm:4000
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM virtual key (not the provider API key): one per consumer, so it can be
# rotated without touching RAGFlow or the back.
LITELLM_API_KEY=
# With the provider prefix LiteLLM expects. It has to be registered in
# iac/k8s/namespaces/ai-form-creator/configs/litellm-config.yaml.
LITELLM_MODEL=gemini/gemini-flash-latest

# RAGFlow, to retrieve the chunks of the chosen documents.
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
