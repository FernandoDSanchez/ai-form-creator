NODE_ENV=development

# Postgres de la app. El worker escribe el estado de cada generación en la misma
# base que el back; las migraciones las corre el back, no éste.
DATABASE_URL=postgresql://app:changeme@localhost:5432/ai_form_creator

# Frontend de Temporal. En el cluster: temporal-server:7233
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Proxy de modelos. En el cluster: http://litellm:4000
LITELLM_BASE_URL=http://localhost:4000
# Virtual key de LiteLLM (no la API key del proveedor): una por consumidor, así
# se rota sin tocar a RAGFlow ni al back.
LITELLM_API_KEY=
# Con el prefijo de proveedor que espera LiteLLM. Tiene que estar dado de alta
# en iac/k8s/namespaces/ai-form-creator/configs/litellm-config.yaml.
LITELLM_MODEL=gemini/gemini-flash-latest

# RAGFlow, para recuperar los fragmentos de los documentos elegidos.
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
