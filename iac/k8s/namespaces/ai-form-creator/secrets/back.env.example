# Postgres del propio namespace (Service `postgres`)
DATABASE_URL=postgresql://app:changeme@app-postgres:5432/ai_form_creator

# Virtual key de LiteLLM (creada desde su UI/API con LITELLM_MASTER_KEY),
# no la API key del proveedor: así rotás sin tocar los proveedores.
LITELLM_API_KEY=

# API key de RAGFlow, generada desde su UI una vez desplegado
RAGFLOW_API_KEY=
