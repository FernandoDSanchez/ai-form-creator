# Postgres of this namespace (Service `app-postgres`)
DATABASE_URL=postgresql://app:changeme@app-postgres:5432/ai_form_creator

# LiteLLM virtual key (created from its UI/API with LITELLM_MASTER_KEY), not the
# provider API key: this way you rotate without touching the providers.
LITELLM_API_KEY=

# RAGFlow API key, generated from its UI once deployed
RAGFLOW_API_KEY=
