# A single Secret feeds RAGFlow and its three backing services.
#
# Generate each password with:  openssl rand -hex 32
#
# CONSTRAINT: no `$`, no backtick and no backslash. The RAGFlow entrypoint
# expands its config template with `eval echo`, so those characters get
# re-evaluated by the shell and the password arrives mangled.

# MYSQL_ROOT_PASSWORD and MYSQL_PASSWORD must be IDENTICAL:
# RAGFlow connects as root.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_flow

ELASTIC_PASSWORD=
REDIS_PASSWORD=

# LiteLLM virtual key (created from its UI/API with LITELLM_MASTER_KEY), not the
# master key and not the provider one. It is consumed by the user_default_llm
# block of service_conf as ${LITELLM_API_KEY}.
LITELLM_API_KEY=

# Credentials of the MinIO Tenant, with permission to create buckets.
# They have to match the ones in secret-minio-storage-configuration.
MINIO_USER=
MINIO_PASSWORD=
