# Un solo Secret alimenta RAGFlow y sus tres backings.
#
# Generá cada password con:  openssl rand -hex 32
#
# RESTRICCIÓN: sin `$`, backtick ni backslash. El entrypoint de RAGFlow expande
# su plantilla de config con `eval echo`, así que esos caracteres los reevalúa
# la shell y el password llega mutilado.

# MYSQL_ROOT_PASSWORD y MYSQL_PASSWORD deben ser IDÉNTICOS:
# RAGFlow se conecta como root.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_flow

ELASTIC_PASSWORD=
REDIS_PASSWORD=

# Virtual key de LiteLLM (creada desde su UI/API con LITELLM_MASTER_KEY), no la
# master key ni la del proveedor. La consume el bloque user_default_llm de
# service_conf como ${LITELLM_API_KEY}.
LITELLM_API_KEY=

# Credenciales del Tenant de MinIO, con permiso para crear buckets.
# Tienen que coincidir con las de secret-minio-storage-configuration.
MINIO_USER=
MINIO_PASSWORD=
