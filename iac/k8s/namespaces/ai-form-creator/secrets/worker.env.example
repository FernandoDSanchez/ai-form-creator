# Postgres de la app. El worker escribe el estado de cada generación en la
# misma base que el back; las migraciones las sigue corriendo el back.
DATABASE_URL=postgresql://app:changeme@app-postgres:5432/ai_form_creator

# Virtual key de LiteLLM. Distinta de la del back y de la de RAGFlow: una por
# consumidor, así se rotan por separado y el gasto se atribuye solo.
LITELLM_API_KEY=

# API key de RAGFlow, para la recuperación de fragmentos.
RAGFLOW_API_KEY=
