# The app's Postgres. The worker writes the status of every generation into the
# same database as the back; migrations are still run by the back.
DATABASE_URL=postgresql://app:changeme@app-postgres:5432/ai_form_creator

# LiteLLM virtual key. Different from the back's and from RAGFlow's: one per
# consumer, so they rotate separately and the spend attributes itself.
LITELLM_API_KEY=

# RAGFlow API key, for chunk retrieval.
RAGFLOW_API_KEY=
