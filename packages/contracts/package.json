{
  "name": "@ai-form-creator/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Contracts shared between apps/back and apps/front. TypeBox schemas: one definition, two consumers.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/cjs/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/cjs/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/cjs/*.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && node scripts/finalize-build.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md}": [
      "prettier --write"
    ]
  }
}
