{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "declaration": true,
    "sourceMap": true,

    // Explícito a propósito: sin esto `tsc` infiere la raíz común de los
    // archivos de entrada y hoy colapsaría `src/regulatory-documents/` en la
    // raíz de `dist/`, rompiendo los subpaths de `exports`.
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
